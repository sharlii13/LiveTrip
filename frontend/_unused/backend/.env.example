ENABLE_WEBSOCKET_MONITORING=true
ENABLE_API_RATE_LIMITING=false

# External API Rate Limits (requests per hour)
OPENWEATHER_RATE_LIMIT=1000
GOOGLE_MAPS_RATE_LIMIT=2500
AVIATIONSTACK_RATE_LIMIT=500
EVENTBRITE_RATE_LIMIT=1000
ACCUWEATHER_RATE_LIMIT=50